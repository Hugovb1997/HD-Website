    <script>
        lucide.createIcons();
        function toggleModal(show) {
            const modal = document.getElementById('booking-modal');
            const success = document.getElementById('booking-success');
            const form = document.getElementById('booking-form');

            if (show) {
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
                success.classList.add('hidden');
                form.classList.remove('hidden');
            } else {
                modal.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }
        }

        function confirmBooking() {
            const success = document.getElementById('booking-success');
            const form = document.getElementById('booking-form');

            form.classList.add('hidden');
            success.classList.remove('hidden');
        }

        // Exit Intent Logic
        let exitIntentShown = false;
        document.addEventListener('mouseleave', (e) => {
            // If mouse leaves the top of the viewport and modal hasn't been shown yet
            if (e.clientY <= 0 && !exitIntentShown) {
                const bookingModal = document.getElementById('booking-modal');
                // Only show if the main booking modal isn't already open
                if (bookingModal.classList.contains('hidden')) {
                    document.getElementById('exit-intent-modal').classList.remove('hidden');
                    document.body.style.overflow = 'hidden';
                    exitIntentShown = true;
                }
            }
        });

        function closeExitIntent() {
            document.getElementById('exit-intent-modal').classList.add('hidden');
            document.body.style.overflow = 'auto';
        }
    </script>
