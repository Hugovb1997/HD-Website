        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;family=Playfair+Display:ital,wght@1,500&amp;display=swap"
        rel="stylesheet" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #050505;
            color: #e5e5e5;
        }

        .font-serif-italic {
            font-family: 'Playfair Display', serif;
            font-style: italic;
        }

        /* Custom Scrollbar for dark theme */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #0a0a0a;
        }

        ::-webkit-scrollbar-thumb {
            background: #262626;
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #404040;
        }

        /* --- Modal & UI Animations --- */
        #booking-modal,
        #exit-intent-modal {
            transition: opacity 0.3s ease-in-out;
        }

        #booking-modal.hidden,
        #exit-intent-modal.hidden {
            opacity: 0;
            pointer-events: none;
        }

        #booking-modal:not(.hidden),
        #exit-intent-modal:not(.hidden) {
            opacity: 1;
            pointer-events: auto;
        }

        @keyframes slideInUp {
            from {
                transform: translateY(20px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .animate-slide-up {
            animation: slideInUp 0.6s ease-out forwards;
        }

        /* --- Engine Animations --- */
        @keyframes rotate-slow {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        @keyframes rotate-slow-reverse {
            0% {
                transform: rotate(360deg);
            }

            100% {
                transform: rotate(0deg);
            }
        }

        @keyframes flow-inward {
            0% {
                stroke-dashoffset: 100;
                opacity: 0;
            }

            20% {
                opacity: 1;
                stroke: #00ffc4;
            }

            80% {
                opacity: 1;
                stroke: #00ffc4;
            }

            100% {
                stroke-dashoffset: 0;
                opacity: 0;
            }
        }

        @keyframes beam-drop-main {
            0% {
                top: -100%;
                height: 50%;
                opacity: 0;
                background: linear-gradient(to bottom, transparent, #00ffc4, transparent);
            }

            30% {
                opacity: 1;
            }

            60% {
                top: 100%;
                height: 50%;
                opacity: 0;
            }

            100% {
                top: 100%;
                height: 50%;
                opacity: 0;
            }
        }

        @keyframes beam-horizontal-expand {

            0%,
            25% {
                width: 0;
                left: 50%;
                opacity: 0;
                background: linear-gradient(to right, transparent, #00ffc4, transparent);
            }

            35% {
                opacity: 1;
            }

            50% {
                width: 100%;
                left: 0;
                opacity: 1;
            }

            75% {
                opacity: 0;
            }

            100% {
                width: 100%;
                left: 0;
                opacity: 0;
            }
        }

        @keyframes beam-drop-feeder {

            0%,
            40% {
                top: -100%;
                height: 50%;
                opacity: 0;
                background: linear-gradient(to bottom, transparent, #00ffc4, transparent);
            }

            50% {
                opacity: 1;
            }

            80% {
                top: 100%;
                height: 50%;
                opacity: 0;
            }

            100% {
                top: 100%;
                height: 50%;
                opacity: 0;
            }
        }

        @keyframes float-card {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-6px);
            }
        }

        .animate-spin-slow {
            animation: rotate-slow 60s linear infinite;
        }

        .animate-spin-slow-reverse {
            animation: rotate-slow-reverse 60s linear infinite;
        }

        .animate-flow-in {
            stroke-dasharray: 10 100;
            animation: flow-inward 3s linear infinite;
        }

        .animate-pulse-main {
            animation: beam-drop-main 3s cubic-bezier(0.4, 0, 0.2, 1) infinite;
        }

        .animate-pulse-expand {
            animation: beam-horizontal-expand 3s cubic-bezier(0.4, 0, 0.2, 1) infinite;
        }

        .animate-pulse-feeder {
            animation: beam-drop-feeder 3s cubic-bezier(0.4, 0, 0.2, 1) infinite;
        }

        .animate-float-card {
            animation: float-card 6s ease-in-out infinite;
        }

        .delay-1 {
            animation-delay: 0.5s;
        }

        .delay-2 {
            animation-delay: 1s;
        }

        .delay-3 {
            animation-delay: 1.5s;
        }

        .mask-radial {
            mask-image: radial-gradient(ellipse 60% 50% at 50% 0%, #000 70%, transparent 100%);
        }

        .btn-glow {
            position: relative;
        }

        .btn-glow::before {
            content: '';
            position: absolute;
            top: -1px;
            left: -1px;
            right: -1px;
            bottom: -1px;
            border-radius: 9999px;
            background: linear-gradient(to right, #00ffc4, #059669);
            z-index: -1;
            opacity: 0.5;
            transition: opacity 0.3s;
        }

        .btn-glow:hover::before {
            opacity: 0.8;
        }

        @keyframes shimmer {
            0% {
                transform: translateX(-100%);
            }

            100% {
                transform: translateX(100%);
            }
        }
    </style>
</head>

